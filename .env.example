# ── MedAI Backend env ──
# Copy to .env (backend folder) — NEVER commit real values.

# Comma-separated allowed origins (frontend URLs jo backend call kar sakti hain)
ALLOWED_ORIGINS=http://localhost:3000,https://final-year-project-medai.vercel.app

# Upload size limit (MB)
MAX_UPLOAD_MB=10

# Rate limit: requests per window per IP
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_S=60

# 1 = startup pe teeno models load (HF Spaces ke liye recommended)
PRELOAD_MODELS=1
